									"key": "tipoEvento",
									"value": "CULTO",
									"type": "text"
								},
								{
									"key": "publicoAlvo",
									"value": "TODOS",
									"type": "text"
								},
								{
									"key": "duracao",
									"value": "MEDIA",
									"type": "text"
								},
								{
									"key": "organizador",
									"value": "Pastor João Silva",
									"type": "text"
								},
								{
									"key": "capacidade",
									"value": "300",
									"type": "text"
								},
								{
									"key": "dataEvento",
									"value": "2025-04-20T09:00:00",
									"type": "text"
								},
								{
									"key": "contactos",
									"value": "999888777",
									"type": "text"
								},
								{
									"key": "img",
									"value": "",
									"type": "file",
									"src": "C:\\Users\\CETE\\Documents\\Leovigildo\\BaluarteInfo\\baluarte\\src\\assets\\actividade\\pascoa.jpg"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/admin/actividade",
							"host": ["{{base_url}}"],
							"path": ["admin", "actividade"]
						}
					}
				}
			]
		},
		{
			"name": "3. Consultar Actividades (Público)",
			"item": [
				{
					"name": "Listar Actividades",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/user/actividade?page=0&size=10",
							"host": ["{{base_url}}"],
							"path": ["user", "actividade"],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "Listar - Filtrar por tipo",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/user/actividade?tipoEvento=CULTO&page=0&size=10",
							"host": ["{{base_url}}"],
							"path": ["user", "actividade"],
							"query": [
								{
									"key": "tipoEvento",
									"value": "CULTO"
								},
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "Detalhe da Actividade",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/user/actividade/{{actividadeId}}",
							"host": ["{{base_url}}"],
							"path": ["user", "actividade", "{{actividadeId}}"]
						}
					}
				},
				{
					"name": "Programação da Actividade",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/user/actividade/{{actividadeId}}/programacao",
							"host": ["{{base_url}}"],
							"path": ["user", "actividade", "{{actividadeId}}", "programacao"]
						}
					}
				}
			]
		},
		{
			"name": "4. Programação (Admin)",
			"item": [
				{
					"name": "Adicionar Item na Programação",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titulo\": \"Culto de Abertura\",\n  \"inicio\": \"2025-04-13T19:00:00\",\n  \"fim\": \"2025-04-13T21:00:00\",\n  \"tipo\": \"SESSAO\",\n  \"ordem\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/actividade/{{actividadeId}}/programacao",
							"host": ["{{base_url}}"],
							"path": ["admin", "actividade", "{{actividadeId}}", "programacao"]
						}
					}
				}
			]
		},
		{
			"name": "5. Inscrição",
			"item": [
				{
					"name": "Inscrever (Público)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Maria Oliveira\",\n  \"email\": \"maria@email.com\",\n  \"telefone\": \"911222333\",\n  \"idade\": 28\n}"
						},
						"url": {
							"raw": "{{base_url}}/public/inscritos/{{actividadeId}}",
							"host": ["{{base_url}}"],
							"path": ["public", "inscritos", "{{actividadeId}}"]
						}
					}
				},
				{
					"name": "Baixar Ficha de Inscrição (PDF)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/public/inscritos/{{inscricaoId}}/pdf",
							"host": ["{{base_url}}"],
							"path": ["public", "inscritos", "{{inscricaoId}}", "pdf"]
